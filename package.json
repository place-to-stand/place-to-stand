    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "lighthouse": "13.5.0",
    "oxlint": "1.93.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",

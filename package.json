    "lucide-react": "1.59.0",
    "next": "16.4.3",
    "posthog-js": "1.438.12",
    "posthog-node": "5.56.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"

{
  "name": "place-to-stand",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/indexnow.mjs",
    "start": "next start",
    "lint": "oxlint -c oxlint.config.mjs --report-unused-disable-directives-severity=error && node --test lint/tests/ && node scripts/voice.mjs",
    "perf": "node scripts/lighthouse.mjs",
    "perf:lcp": "node scripts/lcp.mjs",
    "test:visual": "node scripts/visual.mjs",
    "test:visual:update": "node scripts/visual.mjs --update",
    "test:contrast": "node scripts/contrast.mjs",
    "test:budget": "node scripts/budget.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "test:design": "npm run test:contrast && npm run test:a11y && npm run test:visual && npm run test:budget",
    "format": "prettier --check --cache --cache-location=.cache/prettier \"**/*.{ts,tsx,js,json,md}\"",
    "format:write": "prettier --write --cache --cache-location=.cache/prettier \"**/*.{ts,tsx,js,json,md}\"",
    "type-check": "next typegen && node node_modules/typescript-7/bin/tsc --noEmit",
    "test:lint-rules": "node --test lint/tests/"
